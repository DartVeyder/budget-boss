# Dependency directories
/node_modules/
/vendor/

# Build and dist outputs
/dist/
/build/
/public/build/
/public/hot/
/public/storage/

# Laravel runtime, caches and logs
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/
/storage/framework/testing/
/storage/logs/
/storage/*.key
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test caches and scratch
/.phpunit.cache/
.phpunit.result.cache
/scratch/

# IDE and server configs
/.idea/
/.vscode/
/.fleet/
/.osp/
.env
.env.*
!.env.example

# Large lock files
composer.lock
package-lock.json

# Heavy media, archives and binary files
*.zip
*.tar
*.gz
*.rar
*.7z
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.mp3
*.wav
*.ogg
*.exe
*.dll
*.iso
*.sqlite
*.sql
